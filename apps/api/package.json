{
  "name": "@dwc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify probe engine: performs the network measurements and streams results.",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "//build": "Node 24 strips types natively, so there is nothing to compile — 'build' is a typecheck gate.",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dwc/contracts": "workspace:*",
    "@dwc/diagnostics": "workspace:*",
    "@dwc/persistence": "workspace:*",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@fastify/static": "catalog:",
    "fastify": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
