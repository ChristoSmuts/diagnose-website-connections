{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // applyTheme/readStoredTheme touch the document and localStorage.
    "lib": ["ES2023", "DOM"],
    // Node types are available for typecheck because the test files read the
    // filesystem (scanning tokens.css / component sources). tsconfig.build.json
    // strips them back out, so shipped library code still cannot reach a Node
    // API by accident — this is a browser package.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
