{
  "name": "@dwc/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lit component library. Shadow DOM, token-themed, drop-in for other tools in the ecosystem.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./node_modules/@dwc/tokens/src/tokens.css"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "scripts": {
    "build:styles": "node scripts/build-styles.mjs",
    "build:manifest": "cem analyze --litelement --globs \"src/**/*.ts\" --exclude \"src/**/*.test.ts\" --outdir .",
    "build": "pnpm run build:styles && pnpm run build:icons && tsc -p tsconfig.build.json && pnpm run build:manifest",
    "typecheck": "pnpm run build:styles && pnpm run build:icons && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@dwc/contracts": "workspace:*",
    "@dwc/tokens": "workspace:*",
    "lit": "catalog:"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/cli": "catalog:",
    "@types/node": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
