{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "comment": "Markdown reflowing would mangle the hand-wrapped prose in the docs.",
      "files": ["*.md"],
      "options": { "proseWrap": "preserve" }
    }
  ]
}
