{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    // Playwright resolves its own imports; nothing is emitted from here.
    "moduleResolution": "bundler"
  },
  "include": ["**/*.ts"]
}
